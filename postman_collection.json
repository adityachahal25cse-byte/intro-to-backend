{
  "info": {
    "name": "Backend Tutorial - Express & MongoDB CRUD API",
    "description": "Postman Collection for testing all APIs built in the Backend Tutorial (User Auth & Post CRUD)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Health Check (Root Endpoint)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": [""]
        },
        "description": "Check if backend server is online and list available endpoints"
      }
    },
    {
      "name": "1. User Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"aditya_dev\",\n  \"email\": \"aditya@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/users/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "users", "register"]
            },
            "description": "Register a new user with hashed password in MongoDB"
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"aditya@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/users/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "users", "login"]
            },
            "description": "Authenticate user and compare bcrypt password hash"
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/api/users",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "users"]
            },
            "description": "Fetch list of all registered users (excluding password hashes)"
          }
        }
      ]
    },
    {
      "name": "2. Post CRUD Operations",
      "item": [
        {
          "name": "Create Post (C in CRUD)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My First Backend Post\",\n  \"content\": \"Learning Node.js, Express, and MongoDB CRUD operations!\",\n  \"author\": \"Aditya\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/posts",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "posts"]
            },
            "description": "Create a new post document in MongoDB database"
          }
        },
        {
          "name": "Get All Posts (R in CRUD - Read All)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/api/posts",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "posts"]
            },
            "description": "Retrieve all posts sorted by newest first"
          }
        },
        {
          "name": "Get Post by ID (R in CRUD - Read Single)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/api/posts/REPLACE_WITH_POST_ID",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "posts", "REPLACE_WITH_POST_ID"]
            },
            "description": "Retrieve a specific post by MongoDB _id (replace REPLACE_WITH_POST_ID with actual ID)"
          }
        },
        {
          "name": "Update Post by ID (U in CRUD - Update)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Backend Post Title\",\n  \"content\": \"Successfully updated the content via Express PUT route!\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/posts/REPLACE_WITH_POST_ID",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "posts", "REPLACE_WITH_POST_ID"]
            },
            "description": "Update post title or content using its MongoDB _id"
          }
        },
        {
          "name": "Delete Post by ID (D in CRUD - Delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/api/posts/REPLACE_WITH_POST_ID",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "posts", "REPLACE_WITH_POST_ID"]
            },
            "description": "Delete a post document from MongoDB database"
          }
        }
      ]
    }
  ]
}
